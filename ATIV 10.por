programa
{
    funcao inicio()
    {
        cadeia operador
        inteiro id

        escreva("Nome do operador: ")
        leia(operador)

        escreva("ID da turbina: ")
        leia(id)

        escreva("Turbina ", id,
                 " reiniciada com sucesso pelo operador ",
                 operador, ".\n")
    }
}