programa
{
    funcao inicio()
    {
        cadeia nome
        cadeia empresa
        inteiro acesso

        escreva("Nome do visitante: ")
        leia(nome)

        escreva("Empresa de origem: ")
        leia(empresa)

        escreva("Nivel de acesso: ")
        leia(acesso)

        escreva("\n============================\n")
        escreva("     CRACHA DIGITAL\n")
        escreva("============================\n")
        escreva("Nome: ", nome, "\n")
        escreva("Empresa: ", empresa, "\n")
        escreva("Nivel de Acesso: ", acesso, "\n")
        escreva("============================\n")
    }
}